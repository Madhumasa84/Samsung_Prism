# Offline Phase 1 defaults. No credentials or external service endpoints belong here.
FLOWCONTEXT_APP_NAME=flowcontext-phase1
FLOWCONTEXT_CORPUS_PATH=data/synthetic/documents.jsonl
FLOWCONTEXT_TRANSCRIPT_PATH=data/synthetic/transcript.jsonl
FLOWCONTEXT_EVALUATION_PATH=data/synthetic/evaluation.jsonl
FLOWCONTEXT_EVALUATION_DEVELOPMENT_PATH=data/evaluation/development.jsonl
FLOWCONTEXT_EVALUATION_HELD_OUT_PATH=data/evaluation/held_out.jsonl
FLOWCONTEXT_STREAMING_EVALUATION_DEVELOPMENT_PATH=data/evaluation/streaming_development.jsonl
FLOWCONTEXT_STREAMING_EVALUATION_HELD_OUT_PATH=data/evaluation/streaming_held_out.jsonl
FLOWCONTEXT_ARTIFACTS_DIR=artifacts
FLOWCONTEXT_INDEX_PATH=artifacts/corpus-index.json
FLOWCONTEXT_CORPUS_STATUS=synthetic_fixture
FLOWCONTEXT_RETRIEVAL_BACKEND=dense
FLOWCONTEXT_RETRIEVAL_TOP_K=5
FLOWCONTEXT_CHUNK_MAX_CHARS=1200
FLOWCONTEXT_CHUNK_OVERLAP_CHARS=0
FLOWCONTEXT_MODEL_IDENTITY=baseline.extractive.v1
FLOWCONTEXT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
FLOWCONTEXT_EMBEDDING_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
FLOWCONTEXT_EMBEDDING_LICENSE=apache-2.0
FLOWCONTEXT_EMBEDDING_DIMENSIONS=384
FLOWCONTEXT_EMBEDDING_MODEL_CARD_URL=https://huggingface.co/sentence-transformers/all-MiniLM-L6-v2
FLOWCONTEXT_EMBEDDING_CACHE_DIR=.model-cache
FLOWCONTEXT_EMBEDDING_LOCAL_FILES_ONLY=false
FLOWCONTEXT_GENERATION_BACKEND=mock
FLOWCONTEXT_GENERATION_PROVIDER=flowcontext.mock
FLOWCONTEXT_GENERATION_MODEL=mock-grounded-v1
FLOWCONTEXT_GENERATION_BASE_URL=https://api.openai.com/v1
# Set the named environment variable outside this file; never put the secret here.
FLOWCONTEXT_GENERATION_API_KEY_ENV=FLOWCONTEXT_GENERATION_API_KEY
FLOWCONTEXT_GENERATION_TIMEOUT_S=30
FLOWCONTEXT_GENERATION_MAX_RETRIES=2
FLOWCONTEXT_GENERATION_RETRY_BACKOFF_S=0.5
FLOWCONTEXT_GENERATION_MAX_REPAIR_ATTEMPTS=1
FLOWCONTEXT_GENERATION_MAX_OUTPUT_TOKENS=600
# Leave prices unset unless documented real provider pricing is configured.
# FLOWCONTEXT_GENERATION_INPUT_PRICE_PER_MILLION=
# FLOWCONTEXT_GENERATION_OUTPUT_PRICE_PER_MILLION=
# Phase 2 explainable streaming-controller policy. Debounce uses source-time
# gaps; retrieval execution uses the bounded async scheduler below.
FLOWCONTEXT_STREAMING_DEBOUNCE_SOURCE_S=0.35
FLOWCONTEXT_STREAMING_MIN_QUERY_CHARS=8
FLOWCONTEXT_STREAMING_MIN_TOPIC_TERMS=1
FLOWCONTEXT_STREAMING_MIN_NEW_CONTENT_TERMS=1
FLOWCONTEXT_STREAMING_RETRIEVE_ON_CORRECTION=true
FLOWCONTEXT_STREAMING_RETRIEVE_ON_CONSTRAINT_CHANGE=true
FLOWCONTEXT_STREAMING_DUPLICATE_QUERY_SUPPRESSION=true
FLOWCONTEXT_STREAMING_FINAL_BYPASSES_DEBOUNCE=true
FLOWCONTEXT_STREAMING_MAX_CONCURRENCY=2
FLOWCONTEXT_STREAMING_MAX_PENDING_REQUESTS=4
FLOWCONTEXT_STREAMING_REQUEST_TIMEOUT_S=5
FLOWCONTEXT_STREAMING_MAX_RETRIES=0
FLOWCONTEXT_STREAMING_RETRY_BACKOFF_S=0.05
FLOWCONTEXT_STREAMING_MAX_TOTAL_REQUESTS=16
FLOWCONTEXT_STREAMING_FINAL_WAIT_TIMEOUT_S=5
FLOWCONTEXT_STREAMING_CANCEL_ON_SUPERSESSION=true
